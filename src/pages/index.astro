---
import Base from "~/layouts/Base.astro";
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { SITE, SOCIAL, COMEDY_SOCIALS, BOOKING_EMAIL } from "~/consts";
import FormattedDate from "~/components/FormattedDate.astro";
import ShowEntry from "~/components/ShowEntry.astro";
import NoAiNote from "~/components/NoAiNote.astro";
import stagePhoto from "~/content/shows/images/gcc_2_2029017.jpg";

const today = new Date();
today.setHours(0, 0, 0, 0);
const allShows = await getCollection("shows");
const upcoming = allShows
  .filter((s) => s.data.date.getTime() >= today.getTime())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

// Most recent show with a video doubles as the featured clip.
const featured = allShows
  .filter((s) => s.data.video)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

// High-res press photo promoters can download for posters.
const pressPhoto = await getImage({ src: stagePhoto, width: 2400, format: "jpg", quality: 90 });
---
<Base>
  <section class="mb-14">
    <Image
      src={stagePhoto}
      alt={`${SITE.author} performing stand-up comedy at Ground Culture in Cape Town`}
      widths={[640, 960, 1440]}
      sizes="(min-width: 768px) 720px, 100vw"
      loading="eager"
      format="webp"
      quality={82}
      class="w-full aspect-[3/2] object-cover rounded-xl border border-rule mb-8"
    />
    <p class="small-caps mb-3">{SITE.role}</p>
    <h1 class="font-serif text-[2.4rem] sm:text-[3rem] leading-[1.05] tracking-tight mb-6">
      {SITE.title}
    </h1>
    <div class="prose-rvdm max-w-reading">
      <p>
        I&rsquo;m a stand-up comedian based in {SITE.location.split(",")[0]}, turning the
        everyday awkward moments in life into comedy. You&rsquo;ll mostly find me on
        Cape Town stages, testing new material in front of real people.
      </p>
    </div>
    <div class="flex flex-wrap gap-3 mt-6">
      <a
        href="/shows"
        class="!no-underline inline-block rounded-full bg-accent !text-bg px-5 py-2 text-sm font-medium hover:opacity-90"
      >Upcoming shows</a>
      <a
        href="#bookings"
        class="!no-underline inline-block rounded-full border border-rule px-5 py-2 text-sm font-medium hover:!border-accent"
      >Book me</a>
    </div>
  </section>

  <section class="mb-14">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="font-serif text-2xl tracking-tight">Upcoming shows</h2>
      <a href="/shows" class="text-sm small-caps !no-underline hover:!text-accent">all shows →</a>
    </div>
    {upcoming.length > 0 ? (
      <ul class="divide-y divide-rule">
        {upcoming.map((s) => (
          <li class="py-3">
            <div class="flex items-baseline justify-between gap-4">
              <div>
                <div class="font-serif text-[1.05rem] leading-snug">
                  {s.data.link ? <a href={s.data.link} class="!no-underline hover:text-accent" target="_blank" rel="noopener">{s.data.title}</a> : s.data.title}
                </div>
                <div class="text-xs text-muted mt-0.5">
                  {s.data.venue}{s.data.location && ` · ${s.data.location}`}{s.data.time && ` · ${s.data.time}`}
                  {s.data.tickets && <> · <a href={s.data.tickets} target="_blank" rel="noopener">tickets</a></>}
                </div>
              </div>
              <span class="text-xs text-muted shrink-0"><FormattedDate date={s.data.date} format="long" /></span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted">New dates coming soon. Check back, or follow along on socials.</p>
    )}
  </section>

  {featured && (
    <section class="mb-14">
      <div class="flex items-baseline justify-between mb-1">
        <h2 class="font-serif text-2xl tracking-tight">Watch</h2>
        <a href="/clips" class="text-sm small-caps !no-underline hover:!text-accent">all clips →</a>
      </div>
      <ShowEntry entry={featured} />
    </section>
  )}

  <section class="mb-14">
    <NoAiNote />
  </section>

  <section id="bookings" class="mb-14 scroll-mt-8">
    <h2 class="font-serif text-2xl tracking-tight mb-5">Bookings &amp; press</h2>
    <div class="prose-rvdm max-w-reading">
      <p>
        Running a room, a corporate event, or a festival and need a comic on the lineup?
        Email <span class="whitespace-nowrap">{BOOKING_EMAIL}</span>{COMEDY_SOCIALS.length > 0 && <> or message me on {COMEDY_SOCIALS.map((s, i) => <>{i > 0 && (i === COMEDY_SOCIALS.length - 1 ? " or " : ", ")}<a href={s.href} target="_blank" rel="noopener" class="external">{s.label}</a></>)}</>}.
      </p>
      <p class="text-muted text-[0.95rem]">
        <strong class="text-ink font-medium">Short bio:</strong> {SITE.author} is a Cape Town
        stand-up comedian whose observational material digs into the everyday awkward
        moments everyone has and nobody talks about.
      </p>
      <p class="text-[0.95rem]">
        <a href={pressPhoto.src} download="ruan-van-der-merwe-comedian.jpg">Download a press photo</a>
      </p>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="mb-14">
      <div class="flex items-baseline justify-between mb-5">
        <h2 class="font-serif text-2xl tracking-tight">Recent writing</h2>
        <a href="/writing" class="text-sm small-caps !no-underline hover:!text-accent">all posts →</a>
      </div>
      <ul class="divide-y divide-rule">
        {posts.map((post) => (
          <li class="py-3">
            <a href={`/writing/${post.id}`} class="!no-underline flex items-baseline justify-between gap-4 group">
              <span class="font-serif text-[1.05rem] group-hover:text-accent">{post.data.title}</span>
              <span class="text-xs text-muted shrink-0"><FormattedDate date={post.data.pubDate} format="short" /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="text-muted text-[0.95rem] max-w-reading">
    By day I co-run <a href={SOCIAL.bytefuse} target="_blank" rel="noopener">ByteFuse AI</a>,
    where I lead the science team. If you&rsquo;re here for the machine learning,
    <a href="/research">the research side lives here</a>.
  </p>
</Base>
