---
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";
import ShowEntry from "~/components/ShowEntry.astro";
import { SOCIAL } from "~/consts";

const today = new Date();
today.setHours(0, 0, 0, 0);

const shows = await getCollection("shows");
const upcoming = shows
  .filter((s) => s.data.date.getTime() >= today.getTime())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = shows
  .filter((s) => s.data.date.getTime() < today.getTime())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Comedy"
  description="Stand-up comedy about everyday awkward moments: upcoming shows, past sets, and where to catch me on stage."
>
  <header class="mb-10">
    <h1 class="font-serif text-[2.2rem] sm:text-[2.6rem] tracking-tight mb-3">Comedy</h1>
    <div class="prose-rvdm max-w-reading text-muted">
      <p>
        Alongside the research and the company, I do stand-up &mdash; observational comedy
        about the everyday awkward moments in life, performed mostly in Cape Town rooms.
      </p>
      <p>
        If you run a room and want me on a lineup, get in touch{SOCIAL.instagram ? <> or find me on <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="external">Instagram</a></> : null}.
      </p>
    </div>

    <aside class="mt-8 max-w-reading border-l-2 border-accent bg-surface rounded-r-lg px-5 py-4">
      <p class="small-caps mb-2">No AI was used in the making of this comedy</p>
      <p class="text-[0.97rem] text-ink/90 leading-relaxed">
        I build machine learning systems for a living, so to be absolutely clear: none of my
        material is written, edited, or workshopped with AI. Every joke is mine, written by hand
        and tested in front of real people. I don&rsquo;t think AI belongs in art &mdash; comedy
        included &mdash; and I&rsquo;d rather bomb with my own bad idea than kill with a
        borrowed one.
      </p>
    </aside>
  </header>

  <section class="mb-14">
    <h2 class="font-serif text-2xl tracking-tight mb-5">Upcoming shows</h2>
    {upcoming.length > 0 ? (
      <div>{upcoming.map((entry) => <ShowEntry entry={entry} upcoming />)}</div>
    ) : (
      <p class="text-muted">Nothing on the calendar right now &mdash; check back soon.</p>
    )}
  </section>

  {past.length > 0 && (
    <section class="mb-14">
      <h2 class="font-serif text-2xl tracking-tight mb-5">Past shows</h2>
      <div>{past.map((entry) => <ShowEntry entry={entry} />)}</div>
    </section>
  )}
</Base>
