---
import Base from "~/layouts/Base.astro";
import { getCollection } from "astro:content";
import ShowEntry from "~/components/ShowEntry.astro";
import NoAiNote from "~/components/NoAiNote.astro";
import { COMEDY_SOCIALS, BOOKING_EMAIL } from "~/consts";

const today = new Date();
today.setHours(0, 0, 0, 0);

const shows = await getCollection("shows");
const upcoming = shows
  .filter((s) => s.data.date.getTime() >= today.getTime())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = shows
  .filter((s) => s.data.date.getTime() < today.getTime())
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base
  title="Stand-up Comedy Shows"
  description="Upcoming and past stand-up comedy shows by Ruan van der Merwe, a Cape Town comedian. Dates, venues, tickets, and photos from the night."
>
  <header class="mb-10">
    <h1 class="font-serif text-[2.2rem] sm:text-[2.6rem] tracking-tight mb-3">Shows</h1>
    <div class="prose-rvdm max-w-reading text-muted">
      <p>
        Stand-up comedy &mdash; observational material about the everyday awkward moments
        in life, performed mostly in Cape Town rooms.
      </p>
      <p>
        If you run a room and want me on a lineup, email {BOOKING_EMAIL}{COMEDY_SOCIALS.length > 0 && <> or find me on {COMEDY_SOCIALS.map((s, i) => <>{i > 0 && ", "}<a href={s.href} target="_blank" rel="noopener" class="external">{s.label}</a></>)}</>}.
      </p>
    </div>

    <div class="mt-8"><NoAiNote /></div>
  </header>

  <section class="mb-14">
    <h2 class="font-serif text-2xl tracking-tight mb-5">Upcoming shows</h2>
    {upcoming.length > 0 ? (
      <div>{upcoming.map((entry) => <ShowEntry entry={entry} upcoming />)}</div>
    ) : (
      <p class="text-muted">Nothing on the calendar right now &mdash; check back soon.</p>
    )}
  </section>

  {past.length > 0 && (
    <section class="mb-14">
      <h2 class="font-serif text-2xl tracking-tight mb-5">Past shows</h2>
      <div>{past.map((entry) => <ShowEntry entry={entry} />)}</div>
    </section>
  )}
</Base>
