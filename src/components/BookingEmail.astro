---
// "Email me" link that keeps the booking address away from scrapers.
// The HTML only holds the address reversed and base64-encoded. Nothing is
// decoded on page load: the address is built only when someone clicks, so
// bots that read the HTML or run the page's scripts never see it. On click
// the mail app opens and the link text turns into the address so it can be
// copied.
import { SITE } from "~/consts";

type Props = { class?: string; label?: string; subject?: string };
const { class: className, label = "Email me", subject = "Booking enquiry" } = Astro.props;
const { user, domain } = SITE.bookingEmail;
const encoded = Buffer.from(`${user}@${domain}`.split("").reverse().join("")).toString("base64");
---
<a href="#book" class:list={["js-booking-email", className]} data-e={encoded} data-s={subject}>{label}</a>

<script is:inline>
  (function () {
    if (window.__bookingEmail) return;
    window.__bookingEmail = true;
    document.addEventListener("click", function (ev) {
      var a = ev.target.closest && ev.target.closest("a.js-booking-email");
      if (!a) return;
      ev.preventDefault();
      var addr = atob(a.dataset.e).split("").reverse().join("");
      a.textContent = addr;
      window.location.href = "mailto:" + addr + "?subject=" + encodeURIComponent(a.dataset.s || "");
    });
  })();
</script>
